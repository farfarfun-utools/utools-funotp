# ---- farfarfun 组织约定 (SPEC §10) ----
# 服务脚本的运行时文件：日志 / PID / lock
.run/
logs/
*.log

# 本地数据库与压缩包不进版本管理，确需版本化走 Git LFS
*.db
*.sqlite
*.sqlite3
*.rar
*.7z

# 构建产物（无前导斜杠，任意层级都匹配，含 utools/dist/）
dist/
build/

# 编辑器 / IDE
.idea/
.vscode/
*.swp
.DS_Store

# 凭据：绝不提交
.env
.env.*
!.env.example
*.pem
*.key


# ---- 前端 / uTools 插件 ----
# SPEC §13.4: utools/ 目录本身要提交（plugin.json / preload.js / logo.png 是源文件），
# 只有 utools/dist/ 是构建产物。上面的 dist/ 已覆盖，这里显式写一遍避免被误改。
utools/dist/
# 覆盖率报告：阈值在 vitest.config.ts 里卡着，报告本身是本地产物
coverage/
node_modules/
__pycache__/
*.pyc
.venv/
.pnpm-store/
.vite/
.turbo/
*.tsbuildinfo
pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# ---- 本仓库原有的自定义规则（合并时保留）----
/utools/dist/
/node_modules/
/data/

# ---- AI 编码助手 ----
# 只忽略本地状态；团队有意共享的 agent / 命令 / 规则定义仍然版本化。
# 必须写 `dir/*` 而不是 `dir/`：父目录被整体排除后 git 不会下探，
# 下面的 `!` 取消规则就永远不会生效。
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/skills/
!.claude/settings.json
.codex/*
!.codex/prompts/
.cursor/*
!.cursor/agents/
!.cursor/rules/

# 其余助手：目前没有共享内容，整体忽略
.aider*
.gemini/
.continue/
.windsurf/
.roo/
.cline/
.specstory/
CLAUDE.local.md
AGENTS.local.md

# UPXS outputs and private identity exports
*.upxs
/release/
identity.private*.json
identity.local.json
